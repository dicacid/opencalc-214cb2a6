# Copy to .env for local development. Do not commit .env.
# Values are public project settings plus server-only secrets.
# Create them in the Supabase dashboard and, for datasheet extraction, Lovable.

SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Vite inlines VITE_* into the client bundle at build time.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Optional. Enables cabinet datasheet extraction.
LOVABLE_API_KEY=""
